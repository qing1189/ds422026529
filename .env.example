# DeepSeek 认证（三选一，优先级：DS_TOKENS > DS_TOKEN > DS_ACCOUNTS）
# 多个 token 逗号分隔
DS_TOKENS=
# 单个 token
DS_TOKEN=
# 多个账号，email:password 格式，逗号分隔
DS_ACCOUNTS=

# 服务端口
PORT=3000

# 本服务 API Key 鉴权（可选，留空则不鉴权）
API_KEY=

# 代理配置（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

# 是否合并 thinking 内容到 response（默认 true）
# MERGE_THINKING=true
